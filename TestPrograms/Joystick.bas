10 CLS
15 COLOR 15
20 PRINT "Joystick test"
30 PRINT "Direction: "
40 PRINT "Buttons: "
50 DO
60 LOCATE 11,1
65 IF STICK(0) = 0 THEN GOSUB 1600 ELSE GOSUB 1000
70 REM GOSUB 1600
80 REM LOCATE 11,1
90 REM GOSUB 1000
100 LOCATE 9,2
105 COLOR 13
110 GOSUB 2000
120 LOCATE 14,2
140 GOSUB 3000
150 LOOP
1000 REM Read joystick position
1010 J=STICK(0)
1020 TMP1$=BIN$(J,4)
1030 TMP2$=""
1040 IF J = 0 THEN 1500
1050 COLOR 14
1060 IF RIGHT$(TMP1$,1)="1" THEN TMP2$=TMP2$+CHR$(18) ELSE TMP2$=TMP2$+" "
1070 IF MID$(TMP1$,3,1)="1" THEN TMP2$=TMP2$+CHR$(19) ELSE TMP2$=TMP2$+" "
1080 IF MID$(TMP1$,2,1)="1" THEN TMP2$=TMP2$+CHR$(16) ELSE TMP2$=TMP2$+" "
1090 IF LEFT$(TMP1$,1)="1" THEN TMP2$=TMP2$+CHR$(17) ELSE TMP2$=TMP2$+" "
1400 PRINT TMP2$
1500 RETURN
1600 COLOR 15
1610 PRINT CHR$(18)+CHR$(19)+CHR$(16)+CHR$(17)
1620 RETURN
2000 REM Read joystick buttons
2010 J=STRIG(0)
2020 TMP1$=BIN$(J,4)
2030 TMP2$=""
2040 IF RIGHT$(TMP1$,1)="1" THEN TMP2$=TMP2$+"A" ELSE TMP2$=TMP2$+"a"
2050 IF MID$(TMP1$,3,1)="1" THEN TMP2$=TMP2$+"B" ELSE TMP2$=TMP2$+"b"
2060 IF MID$(TMP1$,2,1)="1" THEN TMP2$=TMP2$+"C" ELSE TMP2$=TMP2$+"c"
2070 IF LEFT$(TMP1$,1)="1" THEN TMP2$=TMP2$+"D" ELSE TMP2$=TMP2$+"d"
2100 PRINT TMP2$
2500 RETURN
3000 REM Read Start button
3010 J=SSTART(0)
3020 IF J=1 THEN COLOR 12 ELSE COLOR 15
3030 PRINT "Start"
3500 RETURN
