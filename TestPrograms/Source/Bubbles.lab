CLS
CntBalls = 4
CntObjects = CntBalls+1

DIM Bnsp(CntObjects-1) : REM Sprite count
DIM Bx(CntBalls+1) : REM X coordinates
DIM By(CntBalls+1) : REM Y coordinates
DIM Bsx(CntBalls+1) : REM X speed
DIM Bsy(CntBalls+1) : REM Y speed
DIM Bax(CntBalls+1) : REM SCB4 address
DIM Bay(CntBalls+1) : REM SCB3 address
DIM Baw(CntBalls+1) : REM SCB2 address

REM 10-270 / 320-496
Bx(1) = 20*128
By(1) = 400*128
Bsx(1) = 9*128
Bsy(1) = 7*128

Bx(2) = 20*128
By(2) = 400*128
Bsx(2) = 6*128
Bsy(2) = 5*128

Bx(3) = 20*128
By(3) = 400*128
Bsx(3) = 7*128
Bsy(3) = 4*128

Bx(4) = 20*128
By(4) = 400*128
Bsx(4) = 3*128
Bsy(4) = 7*128

PRINT "Setting palettes..."
GOSUB @SetupPalettes

PRINT "Loading sprites..."

RESTORE @SpriteInfo
ObjCount = -1
SprCount = 0
I = 0
Bax(0) = $8401
Bay(0) = $8201
Baw(0) = $8001
DO
    READ I
    ObjCount = ObjCount + 1
    SprCount = SprCount + I
    IF I = 0 THEN GOTO @Skip
    Bnsp(ObjCount) = I
    IF ObjCount < 1 THEN GOTO @Skip
    Bax(ObjCount) = Bax(ObjCount-1) + Bnsp(ObjCount-1)
    Bay(ObjCount) = Bay(ObjCount-1) + Bnsp(ObjCount-1)
    Baw(ObjCount) = Baw(ObjCount-1) + Bnsp(ObjCount-1)
@Skip:
LOOP UNTIL I = 0

DOKE $3C0004,1 : REM REG_VRAMMOD = 1

REM Load sprites

GOSUB @LoadSprites_SCB1
RESTORE @Sprites_SCB2
GOSUB @LoadSprites_SCB2
RESTORE @Sprites_SCB3
GOSUB @LoadSprites_SCB3
RESTORE @Sprites_SCB4
GOSUB @LoadSprites_SCB4
REM Loading finished
GOSUB @ClearFixLayer

DO
    FOR Bl = 1 TO CntBalls
        x = Bx(Bl) + Bsx(Bl)
        IF x > $8700 THEN Bsx(Bl) = -1 * Bsx(Bl)
        IF x < $500 THEN Bsx(Bl) = -1 * Bsx(Bl)
        Bx(Bl) = x
        y = By(Bl) + Bsy(Bl)
        IF y > $F800 THEN Bsy(Bl) = -1 * Bsy(Bl)
        IF y < $A000 THEN Bsy(Bl) = -1 * Bsy(Bl)
        By(Bl) = y
        DOKE $3C0000, Bax(Bl)
        DOKE $3C0002, x
        DOKE $3C0000, Bay(Bl)
        DOKE $3C0002, 2 + y
    NEXT Bl
LOOP

@ClearFixLayer: REM Clear fix layer
DOKE $3C0000,$7000 : REM move.w #$7000,REG_VRAMADD
FOR I = 1 TO 1280
DOKE $3C0002,$ff : REM move.w d0,REG_VRAMRW
NEXT I
RETURN

@SetupPalettes: REM Setup palettes
RESTORE @PaletteData
Address = $400000 + 512
FOR Palette = 1 TO 7
    FOR ColIndex = 1 TO 16
        READ Color
        DOKE Address,Color
        Address = Address + 2
    NEXT ColIndex
NEXT Palette
RETURN

@LoadSprites_SCB1:
VRPointer = $0040 : REM Vram pointer points to beginning of SCB1 area + 1 sprite
RESTORE @Sprites_SCB1
FOR I = 1 TO SprCount
    DOKE $3C0000, VRPointer : REM Set REG_VRAMADD
    READ TiCount
    FOR J = 1 TO TiCount
        READ w
        DOKE $3C0002, w : REM write word to REG_VRAMRW
    NEXT J
    VRPointer = VRPointer + 64
NEXT I
RETURN

@LoadSprites_SCB2:
DOKE $3C0000,$8001 : REM Vram pointer points to beginning of SCB2 area + 1 sprite
RESTORE @Sprites_SCB2
GOSUB @LoadSpriteData
RETURN

@LoadSprites_SCB3:
DOKE $3C0000,$8201 : REM Vram pointer points to beginning of SCB3 area + 1 sprite
RESTORE @Sprites_SCB3
GOSUB @LoadSpriteData
RETURN

@LoadSprites_SCB4:
DOKE $3C0000,$8401 : REM Vram pointer points to beginning of SCB4 area + 1 sprite
RESTORE @Sprites_SCB4
GOSUB @LoadSpriteData
RETURN

@LoadSpriteData:
FOR I = 1 TO SprCount
    READ w
    DOKE $3C0002, w : REM write word to REG_VRAMRW
NEXT I
RETURN

@PaletteData:
DATA $0000, $7fff, $5013, $5013, $1449, $29ae, $7bbf, $2962, $5ef7, $6ffa, $5a35, $2fac, $2fce, $2162, $5adb, $7dfd
