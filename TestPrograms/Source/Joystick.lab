CLS
COLOR 15
PRINT "Joystick test"
PRINT "Direction: "
PRINT "Buttons: "
DO
LOCATE 11,1
IF STICK(0) = 0 THEN GOSUB @DisplayDefaultJoystickState ELSE GOSUB @ReadJoyPosition
LOCATE 9,2
COLOR 13
GOSUB @ReadJoystickButtons
LOCATE 14,2
GOSUB @ReadStartButton
LOOP
@ReadJoyPosition: REM Read joystick position
J=STICK(0)
TMP1$=BIN$(J,4)
TMP2$=""
IF J = 0 THEN @Return
COLOR 14
IF RIGHT$(TMP1$,1)="1" THEN TMP2$=TMP2$+CHR$(18) ELSE TMP2$=TMP2$+" "
IF MID$(TMP1$,3,1)="1" THEN TMP2$=TMP2$+CHR$(19) ELSE TMP2$=TMP2$+" "
IF MID$(TMP1$,2,1)="1" THEN TMP2$=TMP2$+CHR$(16) ELSE TMP2$=TMP2$+" "
IF LEFT$(TMP1$,1)="1" THEN TMP2$=TMP2$+CHR$(17) ELSE TMP2$=TMP2$+" "
PRINT TMP2$
@Return: RETURN
@DisplayDefaultJoystickState:
COLOR 15
PRINT CHR$(18)+CHR$(19)+CHR$(16)+CHR$(17)
RETURN
@ReadJoystickButtons: REM Read joystick buttons
J=STRIG(0)
TMP1$=BIN$(J,4)
TMP2$=""
IF RIGHT$(TMP1$,1)="1" THEN TMP2$=TMP2$+"A" ELSE TMP2$=TMP2$+"a"
IF MID$(TMP1$,3,1)="1" THEN TMP2$=TMP2$+"B" ELSE TMP2$=TMP2$+"b"
IF MID$(TMP1$,2,1)="1" THEN TMP2$=TMP2$+"C" ELSE TMP2$=TMP2$+"c"
IF LEFT$(TMP1$,1)="1" THEN TMP2$=TMP2$+"D" ELSE TMP2$=TMP2$+"d"
PRINT TMP2$
RETURN
@ReadStartButton: REM Read Start button
J=SSTART(0)
IF J=1 THEN COLOR 12 ELSE COLOR 15
PRINT "Start"
RETURN
