? TAB(9);"Amazing program"
? TAB(7);"Creative  Computing"
? TAB(6);"Morristown New Jersey"
?
? TAB(9);"EhBASIC version"
? TAB(9);"by  Lee Davison"
? TAB(5);"leeedavison@lycos.co.uk"
?
@L100:
INPUT "Please enter width and length";H,V
IF ((H>1) AND (H<13)) AND ((V>1) AND (V<13)) THEN @L140		
? "Expected dimensions between 1 and 12, please try again" : GOTO @L100
@L140:
DIM W(H,V),V(H,V)
?
Q=0:Z=0:X=INT(RND(0)*H+1)
FOR I=1 TO H
  IF I=X THEN ? "+  "; : GOTO @L180
  ? "+--";
@L180:
NEXT I
? "+"
C=1:W(X,1)=C:INC C
R=X:S=1:GOTO @L260
@L210:
IF R<>H THEN @L240
IF S<>V THEN @L230
R=1:S=1:GOTO @L250
@L230:
R=1:INC S:GOTO @L250
@L240:
INC R
@L250:
IF W(R,S)=0 THEN @L210
@L260:
IF R=1 THEN @L530
IF W(R-1,S) THEN @L530
IF S=1 THEN @L390
IF W(R,S-1) THEN @L390
IF R=H THEN @L330
IF W(R+1,S) THEN @L330
X=INT(RND(0)*3+1)
ON X GOTO @L790,@L820,@L860
@L330:
IF S<>V THEN @L340
IF Z=1 THEN @L370
Q=1:GOTO @L350
@L340:
IF W(R,S+1) THEN @L370
@L350:
X=INT(RND(0)*3+1)
ON X GOTO @L790,@L820,@L910
@L370:
X=INT(RND(0)*2+1)
ON X GOTO @L790,@L820
@L390:
IF R=H THEN @L470
IF W(R+1,S) THEN @L470
IF S<>V THEN @L420
IF Z=1 THEN @L450
Q=1:GOTO @L430
@L420:
IF W(R,S+1) THEN @L450
@L430:
X=INT(RND(0)*3+1)
ON X GOTO @L790,@L860,@L910
@L450:
X=INT(RND(0)*2+1)
ON X GOTO @L790,@L860
@L470:
IF S<>V THEN @L490
IF Z=1 THEN @L790
Q=1:GOTO @L500
@L490:
IF W(R,S+1) THEN @L790
@L500:
X=INT(RND(0)*2+1)
ON X GOTO @L790,@L910
@L530:
IF S=1 THEN @L670
IF W(R,S-1) THEN @L670
IF R=H THEN @L610
IF W(R+1,S) THEN @L610
IF S<>V THEN @L560
IF Z=1 THEN @L590
Q=1:GOTO @L570
@L560:
IF W(R,S+1) THEN @L590
@L570:
X=INT(RND(0)*3+1)
ON X GOTO @L820,@L860,@L910
@L590:
X=INT(RND(0)*2+1)
ON X GOTO @L820,@L860
@L610:
IF S<>V THEN @L630
IF Z=1 THEN @L660
Q=1:GOTO @L640
@L630:
IF W(R,S+1) THEN @L660
@L640:
X=INT(RND(0)*2+1)
ON X GOTO @L820,@L910
@L660:
GOTO @L820
@L670:
IF R=H THEN @L740
IF W(R+1,S) THEN @L740
IF S<>V THEN @L700
IF Z=1 THEN @L730
Q=1:GOTO @L830
@L700:
IF W(R,S+1) THEN @L730
X=INT(RND(0)*2+1)
ON X GOTO @L860,@L910
@L730:
GOTO @L860
@L740:
IF S<>V THEN @L760
IF Z=1 THEN @L210
Q=1:GOTO @L910
@L760:
IF W(R,S+1) THEN @L210
GOTO @L910
@L790:
W(R-1,S)=C
INC C:V(R-1,S)=2:DEC R
IF C=H*V+1 THEN @L1010
Q=0:GOTO @L260
@L820:
W(R,S-1)=C
@L830:
INC C
V(R,S-1)=1:DEC S:IF C=H*V+1 THEN @L1010
Q=0:GOTO @L260
@L860:
W(R+1,S)=C
INC C:IF V(R,S)=0 THEN @L880
V(R,S)=3:GOTO @L890
@L880:
V(R,S)=2
@L890:
INC R
IF C=H*V+1 THEN @L1010
GOTO @L530
@L910:
IF Q=1 THEN @L960
W(R,S+1)=C:INC C:IF V(R,S)=0 THEN @L940
V(R,S)=3:GOTO @L950
@L940:
V(R,S)=1
@L950:
INC S:IF C=H*V+1 THEN @L1010
GOTO @L260
@L960:
Z=1
IF V(R,S)=0 THEN @L980
V(R,S)=3:Q=0:GOTO @L210
@L980:
V(R,S)=1:Q=0:R=1:S=1:GOTO @L250
@L1010:
FOR J=1 TO V
  ? "l";
  FOR I=1 TO H
    IF V(I,J)AND-2 THEN ? "   "; : GOTO @L1040
    ? "  l";
@L1040:
  NEXT I
  ?
  FOR I=1 TO H
    IF V(I,J)AND-3 THEN ? "+  "; : GOTO @L1070
    ? "+--";
@L1070:
  NEXT I
  ? "+"
  NEXT J
END
